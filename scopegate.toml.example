# ScopeGate configuration (example scaffold)
# Copy to scopegate.toml and adjust for your environment.
# IMPORTANT: illustrative only. Schema/loader/runtime enforcement are not finalized;
# some fields may not be read by current gateway config loader yet.
# Iteration M0/M6/M7/M8: config/docs alignment only. Real integrations remain blockers
# (Biscuit/Cedar/full rmcp runtime/sqlx durable stores/secret adapters/crypto audit).

[server]
# Planned MCP/API bind settings (HTTP/MCP server not fully implemented).
host = "127.0.0.1"
port = 8080
# admin_host = "127.0.0.1"
# admin_port = 8081
# request_timeout_ms = 30000

[gateway]
# Target: deny-by-default, fail-closed on policy/audit/store/token errors.
default_decision = "deny"
policies_path = "policies/examples"
# fail_closed_on_policy_error = true
# fail_closed_on_audit_error = true
# max_request_body_bytes = 1048576

[store]
# S1 target: sqlite (WAL). S2 target: postgres.
backend = "sqlite" # sqlite | postgres
database_url = "sqlite:///data/scopegate.db"
# migrate_on_start = false

[auth]
# Planned: Biscuit token verification, key IDs/rotation, revocation/budget state.
mode = "token" # planned
# token_issuer = ""
# token_audience = ""
# jwks_or_public_keys_path = ""

[approvals]
# Planned: approval workflow (timeout defaults to deny).
enabled = false
# timeout_seconds = 300
# persistence = "memory" # memory|sqlite|postgres (planned)

[observability]
# Planned M6 surfaces/hooks: /healthz, /readyz, /metrics, tracing/OTel.
health_enabled = false
ready_enabled = false
metrics_enabled = false
tracing_enabled = false
# metrics_path = "/metrics"
# log_format = "json"

[limits]
# Planned M6 hooks: per-token/principal/upstream budgets and rate limits.
enabled = false
# default_max_calls_per_task = 0
# requests_per_minute = 0

[taint]
# Planned M6 hooks: label propagation and taint-aware egress enforcement.
enabled = false
# block_conflicted_external_egress = true

[broker]
# Planned: secret resolution/injection/redaction adapters (env/file/vault/etc.).
enabled = false
# adapter = "env"

[audit]
# Planned: durable hash-chained append-before-return (current core/store are non-crypto/in-memory scaffolds).
enabled = true
mode = "scaffold" # scaffold | durable (planned)
# hash = "fnv1a-placeholder" # target: cryptographic
# path = "./audit.jsonl"

[dashboard]
# Vite+React+TS scaffold under dashboard/ (build verified; no backend integration).
enabled = false
# host = "127.0.0.1"
# port = 3000

# [[upstreams]]
# name = "example"
# kind = "mcp-stdio" # planned
# command = "..."
# args = []
# env = {}
# allowed_tools = []
