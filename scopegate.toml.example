# ScopeGate runtime configuration example (aligned to current gateway loader)
#
# Copy to `scopegate.toml` (or point GATEWAY_CONFIG at this file) and adjust.
# Loader reads: [gateway], [[rule]], [mcp], [[mcp_upstream]].
# Unknown sections/keys may be ignored by the current runtime loader; safe defaults
# are fail-closed/deny-by-default. Production integrations remain incomplete
# (Biscuit/Cedar/full rmcp runtime/persistent guarantees) — treat as preview config.

[gateway]
# Runtime safety defaults.
fail_closed = true
require_token_scope_for_action = true
# egress_policy: require_approval_on_conflict (default/fail-closed) | block_on_conflict
egress_policy = "require_approval_on_conflict"

# Listen address for HTTP mode (env GATEWAY_ADDR overrides).
listen_addr = "127.0.0.1:8080"

# S1/S2 preview store wiring (durable adapters; fail-closed on init/connect/migrate errors).
# Env overrides: GATEWAY_STORE_BACKEND/SCOPEGATE_STORE_BACKEND and
# GATEWAY_STORE_URL/GATEWAY_DATABASE_URL/SCOPEGATE_DATABASE_URL/DATABASE_URL.
store_backend = "sqlite_wal" # memory|sqlite_wal|sqlite|postgres (sqlite/postgres runtime wiring present in preview; guarantees unproven)
store_database_url = "sqlite://./.scopegate/scopegate.db"

# Runtime hooks (keep conservative defaults unless explicitly needed).
persist_audit_events = false
sync_revocations_from_store = false
use_approval_store = false
enable_rate_limit_state = true
# rate_limit_per_token_call_limit = 0
# rate_limit_per_token_budget = 0

# Optional static revocations (token IDs), comma-separated in env GATEWAY_REVOKED_TOKEN_IDS.
# revoked_token_ids = []

# Minimal demo-safe rules (explicit permits; everything else denied/fails closed).
# gateway main also injects a small default set only when no rules are loaded.
[[rule]]
principal = "agent"
action = "tool.invoke"
resource = "tool"
decision = "permit"

[[rule]]
principal = "anonymous"
action = "tools/list"
resource = "tools/list"
decision = "permit"

[[rule]]
principal = "anonymous"
action = "tools/call"
resource = "gateway.health"
decision = "permit"

[[rule]]
principal = "anonymous"
action = "tools/call"
resource = "tools/call"
decision = "permit"

[mcp]
# HTTP server mode by default; set to "stdio" for MCP stdio serving.
mode = "http"
# default_upstream = "demo-upstream"

# Real upstream wiring (runtime-read). Configure at least one upstream for pool dispatch.
# You can also wire a single upstream via env:
#   GATEWAY_MCP_UPSTREAM_URL=https://...        (http)
#   GATEWAY_MCP_UPSTREAM_CMD=/path/to/server   (stdio) + GATEWAY_MCP_UPSTREAM_ARGS="..."
#   GATEWAY_MCP_UPSTREAM_ID=demo-upstream
#
# Example: stdio MCP upstream (replace program/args with a real MCP server command).
# [[mcp_upstream]]
# id = "demo-upstream"
# transport = "stdio"
# program = "node"
# args = ["./path/to/mcp-server.js"]
# # cwd = "."
# # max_leases = 1
# # max_retries = 0
# # [mcp_upstream.env]
# # EXAMPLE_TOKEN = "replace-me"
#
# Example: HTTP MCP upstream.
# [[mcp_upstream]]
# id = "demo-http"
# transport = "http"
# endpoint = "http://127.0.0.1:9000/mcp"
# # max_leases = 4
# # max_retries = 1
# # [mcp_upstream.headers]
# # Authorization = "Bearer replace-me"

